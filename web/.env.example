# 仅为示例。不要提交真实凭据、Cookie、数据库或生产地址。
ANON_MUSIC_DB=/var/lib/anon-music/player_data.db
ANON_MUSIC_DEVICE=/var/lib/anon-music/qq_device.json
ANON_MUSIC_QQ_CREDENTIAL=/var/lib/anon-music/qq_credential.json
# 示例：本机回环端口。请替换为你自己的私有默认音源。
ANON_MUSIC_DEFAULT_NCM_BASE=http://127.0.0.1:3000
ANON_MUSIC_HOST=127.0.0.1
ANON_MUSIC_PORT=8080

ADMIN_USERNAME=admin
ADMIN_SALT=replace-me
ADMIN_HASH=replace-me
ALLOWED_ORIGINS=https://music.example.com
PLAYER_HOSTS=music.example.com
PLAYER_URL=https://music.example.com/
DOWNLOAD_URL=https://downloads.example.com/

SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Anon Music
